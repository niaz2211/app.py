rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Users collection: registration, profile and balance
    match /users/{userId} {
      allow read, write: if true;
    }
    
    // Deposits collection: deposit requests and approval
    match /deposits/{depositId} {
      allow read, write: if true;
    }
    
    // Contest entries collection: ticket entries
    match /contest_entries/{entryId} {
      allow read, write: if true;
    }
    
    // Site settings: hero mobile customizer and gateway numbers
    match /site_settings/{docId} {
      allow read, write: if true;
    }
    
    // Contests collection
    match /contests/{contestId} {
      allow read, write: if true;
    }
  }
}
